import numpy as np
import matplotlib.pyplot as plt

# Categories and feature scores (arbitrary scaling from 1 to 5 for comparison)
categories = [
    "Microcontroller/Processor", "Sensors Used", "Irrigation Control", "Nutrient Management",
    "Real-time Monitoring", "Machine Learning Integration", "Scalability", "Energy Efficiency",
    "Remote Accessibility", "Cost", "Suitability"
]

systems = [
    "Sproutic", "Arduino-based Smart Garden", "IoT-based Smart Irrigation",
    "AI-Driven Smart Agriculture", "AI-Based Drip Irrigation"
]

scores = {
    "Sproutic": [4, 5, 5, 5, 5, 5, 4, 4, 5, 3, 4],
    "Arduino-based Smart Garden": [2, 3, 2, 1, 1, 1, 2, 3, 1, 5, 2],
    "IoT-based Smart Irrigation": [3, 3, 4, 1, 4, 1, 3, 3, 4, 3, 3],
    "AI-Driven Smart Agriculture": [5, 5, 5, 1, 5, 5, 5, 1, 5, 1, 5],
    "AI-Based Drip Irrigation": [4, 3, 5, 1, 3, 5, 3, 2, 1, 2, 3]
}

# Convert to NumPy array
num_categories = len(categories)
x = np.arange(num_categories)
bar_width = 0.15

# Plot bars
fig, ax = plt.subplots(figsize=(12, 6))

for i, (system, values) in enumerate(scores.items()):
    ax.bar(x + i * bar_width, values, bar_width, label=system)

ax.set_xlabel("Features")
ax.set_ylabel("Score (1-5)")
ax.set_title("Graphical Comparative Analysis of Smart Gardening Systems")
ax.set_xticks(x + bar_width * 2)
ax.set_xticklabels(categories, rotation=45, ha='right')
ax.legend()
ax.grid(axis='y', linestyle='--', alpha=0.7)

plt.tight_layout()
plt.show()